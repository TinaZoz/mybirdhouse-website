---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';

const cities = [
  'Maple Ridge', 'Pitt Meadows', 'Mission', 'Coquitlam',
  'Port Coquitlam', 'Port Moody', 'Langley', 'Abbotsford',
  'Surrey', 'New Westminster', 'Burnaby', 'Chilliwack',
  'North Vancouver', 'West Vancouver', 'Vancouver', 'Richmond',
];
---

<Layout
  title="Service Areas — My Birdhouse"
  description="Where My Birdhouse installs smart home systems across British Columbia — Maple Ridge, Metro Vancouver, the Fraser Valley, and beyond."
>
  <div class="min-h-screen bg-background">
    <Header />
    <main class="pt-32 pb-24 md:pt-40">
      <div class="mx-auto max-w-5xl px-5 md:px-8">
        <p class="text-sm font-bold uppercase tracking-[0.25em] text-accent">Where we work</p>
        <h1 class="h-display mt-4 text-4xl md:text-6xl">
          Serving homes
          <br />
          <span class="font-script font-semibold tracking-normal text-accent">across BC.</span>
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-muted-foreground">
          My Birdhouse is based in Maple Ridge, BC, and installs across the
          province. Here are the communities we work in most often —
          don't see yours? Reach out anyway.
        </p>

        <div class="mt-14 rounded-3xl border border-border bg-card p-7 md:p-10">
          <div class="grid grid-cols-2 gap-x-6 gap-y-3 sm:grid-cols-3 md:grid-cols-4">
            {cities.map((city) => (
              <div class="flex items-center gap-2.5 text-sm font-semibold">
                <Icon name="map-pin" class="h-4 w-4 shrink-0 text-accent" strokeWidth={2} />
                {city}
              </div>
            ))}
          </div>
        </div>

        <div class="mt-10 rounded-2xl border border-border bg-secondary/50 p-5 text-sm leading-relaxed text-muted-foreground">
          Outside these communities? We still want to hear from you — as a
          BC-wide business, we coordinate travel and licensed subcontractor
          work (electrical, plumbing) locally to wherever your home is.
        </div>

        <a href="/#quote" class="btn-dark mt-8 inline-flex px-6 py-3 text-sm">Check if we serve your address</a>
      </div>
    </main>
    <Footer />
  </div>
</Layout>
