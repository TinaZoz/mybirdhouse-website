---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  updated: string;
}

const { title, updated } = Astro.props;
---

<Layout title={`${title} — My Birdhouse`} description={`${title} for My Birdhouse, a smart home integration and consulting business based in Maple Ridge, BC.`}>
  <div class="min-h-screen bg-background">
    <Header />
    <main class="pt-32 pb-24 md:pt-40">
      <div class="mx-auto max-w-3xl px-5 md:px-8">
        <p class="text-sm font-bold uppercase tracking-[0.25em] text-accent">Legal</p>
        <h1 class="h-display mt-4 text-4xl md:text-5xl">{title}</h1>
        <p class="mt-3 text-sm font-semibold text-muted-foreground">Last updated: {updated}</p>

        <div class="prose-legal mt-10 space-y-6 text-sm leading-relaxed text-foreground/85 md:text-base">
          <slot />
        </div>

        <div class="mt-14 rounded-2xl border border-border bg-secondary/50 p-5 text-sm text-muted-foreground">
          Questions about this page? Email us at
          <a href="mailto:info@mybirdhouse.ca" class="font-semibold text-accent hover:underline">info@mybirdhouse.ca</a>.
        </div>

        <a href="/" class="mt-8 inline-flex items-center gap-1.5 text-sm font-bold text-foreground hover:text-accent">
          ← Back to home
        </a>
      </div>
    </main>
    <Footer />
  </div>
</Layout>

<style>
  .prose-legal :global(h2) {
    margin-top: 2rem;
    font-size: 1.15rem;
    font-weight: 900;
    letter-spacing: -0.01em;
  }
  .prose-legal :global(p) {
    margin-top: 0.5rem;
  }
  .prose-legal :global(ul) {
    margin-top: 0.5rem;
    padding-left: 1.25rem;
    list-style: disc;
  }
  .prose-legal :global(li) {
    margin-top: 0.35rem;
  }
  .prose-legal :global(a) {
    color: var(--color-accent);
    font-weight: 600;
    text-decoration: underline;
  }
</style>
