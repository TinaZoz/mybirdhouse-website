---
import Icon from './Icon.astro';

const features = [
  { icon: 'plug-zap', title: 'Control anything', text: '"Turn off the outlets in the kids\u2019 room" — done, wherever you are.' },
  { icon: 'shield-check', title: 'Security check-ups', text: '"Is everything locked?" — a full status report in seconds.' },
  { icon: 'list-checks', title: 'Give it tasks', text: '"Warm the house to 22\u00b0 by 6 pm Friday" — it remembers and does it.' },
  { icon: 'plane', title: 'Works from anywhere', text: 'Airport, office, another continent — your home is one message away.' },
];

const showcases = [
  { img: 'assistant-1.jpg', caption: 'Check in from anywhere', sub: 'Package arrived, garage closed, room warming up — one voice note, full answer.' },
  { img: 'assistant-2.jpg', caption: 'One thread for the whole family', sub: 'Parents, kids, grandparents — everyone talks to the same home, in their own language.' },
  { img: 'assistant-3.jpg', caption: 'Investigates, not just alerts', sub: 'A stain isn\u2019t a new leak — it tells you what it is, where it\u2019s from, and whether it\u2019s still active.' },
  { img: 'assistant-4.jpg', caption: 'Catches problems while you sleep', sub: 'Water running 40 minutes straight at 2am — flagged, explained, with the shutoff location ready.' },
  { img: 'assistant-5.jpg', caption: 'Explains the bill, not just the number', sub: 'Which room, which days, how much it cost — and offers to warn you next time.' },
];
---

<section id="assistant" class="py-14 md:py-20">
  <div class="mx-auto grid max-w-7xl items-stretch gap-12 px-5 md:px-8 lg:grid-cols-2 lg:gap-16">
    <div class="reveal flex flex-col">
      <p class="flex items-center gap-2 text-sm font-bold uppercase tracking-[0.25em] text-accent">
        <Icon name="bot-message-square" class="h-4 w-4" /> Optional add-on
      </p>
      <h2 class="h-display mt-4 text-4xl md:text-6xl">
        Text your home.
        <br />
        <span class="font-script font-semibold tracking-normal text-accent">It texts back.</span>
      </h2>
      <p class="mt-6 max-w-md text-lg leading-relaxed text-muted-foreground">
        The AI Home Assistant is your personal home manager inside Telegram.
        No new app to learn — just chat. Ask it to switch off outlets, run a
        security check, set the heating — from the office, the airport or a
        beach halfway around the world.
      </p>

      <ul class="mt-8 space-y-5">
        {features.map((f) => (
          <li class="flex items-start gap-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-foreground text-background">
              <Icon name={f.icon} class="h-5 w-5" strokeWidth={1.7} />
            </span>
            <div>
              <div class="text-sm font-black uppercase tracking-wider">{f.title}</div>
              <div class="mt-1 text-sm leading-relaxed text-muted-foreground">{f.text}</div>
            </div>
          </li>
        ))}
      </ul>

      <div class="mt-8 flex items-start gap-3 rounded-2xl border-2 border-accent bg-accent/10 p-4">
        <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent text-accent-foreground">
          <Icon name="lock-keyhole" class="h-4 w-4" strokeWidth={2} />
        </span>
        <p class="text-sm font-bold leading-relaxed text-foreground">
          Runs locally on your home controller — conversations and commands
          stay private, and core automations keep working even if the
          internet drops.
        </p>
      </div>
    </div>

    <div class="reveal flex">
      <div id="assistant-carousel" class="relative flex w-full flex-col overflow-hidden rounded-3xl shadow-2xl shadow-foreground/20">
        <div class="relative min-h-[320px] flex-1 overflow-hidden">
          <div id="assistant-track" class="flex h-full transition-transform duration-500 ease-out">
            {showcases.map((s) => (
              <div class="h-full w-full shrink-0">
                <button type="button" class="assistant-zoom block h-full w-full cursor-zoom-in" data-index={showcases.indexOf(s)} aria-label={`Enlarge: ${s.caption}`}>
                  <img
                    src={`/images/assistant/${s.img}`}
                    alt={s.caption}
                    class="h-full w-full object-cover"
                    draggable="false"
                  />
                </button>
              </div>
            ))}
          </div>

          <button
            id="assistant-prev"
            aria-label="Previous example"
            class="absolute left-3 top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-card/90 text-foreground shadow-lg backdrop-blur transition-transform hover:scale-105"
          >
            <Icon name="arrow-right" class="h-4 w-4 rotate-180" />
          </button>
          <button
            id="assistant-next"
            aria-label="Next example"
            class="absolute right-3 top-1/2 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-card/90 text-foreground shadow-lg backdrop-blur transition-transform hover:scale-105"
          >
            <Icon name="arrow-right" class="h-4 w-4" />
          </button>

          <button
            id="assistant-zoom-hint"
            aria-label="Enlarge current screenshot"
            class="absolute right-3 top-3 flex h-9 w-9 items-center justify-center rounded-full bg-card/80 text-foreground shadow-lg backdrop-blur transition-transform hover:scale-105"
          >
            <Icon name="expand" class="h-4 w-4" />
          </button>
        </div>

        <div class="shrink-0 bg-foreground px-5 py-4 md:px-7 md:py-5">
          <div id="assistant-caption" class="text-base font-black tracking-tight text-background md:text-lg">{showcases[0].caption}</div>
          <p id="assistant-sub" class="mt-1.5 text-sm leading-relaxed text-background/80">{showcases[0].sub}</p>
          <div class="mt-3 flex gap-2">
            {showcases.map((_, i) => (
              <button
                class="assistant-dot h-2 w-2 rounded-full bg-background/30 transition-all duration-300"
                data-index={i}
                aria-label={`Go to example ${i + 1}`}
              />
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>

  <div
    id="assistant-lightbox"
    class="fixed inset-0 z-[70] hidden items-center justify-center bg-foreground/90 p-6 backdrop-blur-sm"
  >
    <button
      id="assistant-lightbox-close"
      aria-label="Close"
      class="absolute right-5 top-5 flex h-11 w-11 items-center justify-center rounded-full bg-background/10 text-background hover:bg-background/20"
    >
      <Icon name="x" class="h-5 w-5" />
    </button>

    <button
      id="assistant-lightbox-prev"
      aria-label="Previous example"
      class="absolute left-3 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-background/10 text-background hover:bg-background/20 sm:left-5"
    >
      <Icon name="arrow-right" class="h-5 w-5 rotate-180" />
    </button>
    <button
      id="assistant-lightbox-next"
      aria-label="Next example"
      class="absolute right-3 top-1/2 flex h-11 w-11 -translate-y-1/2 items-center justify-center rounded-full bg-background/10 text-background hover:bg-background/20 sm:right-5"
    >
      <Icon name="arrow-right" class="h-5 w-5" />
    </button>

    <img id="assistant-lightbox-img" src="" alt="" class="max-h-[90vh] max-w-[95vw] select-none rounded-2xl shadow-2xl" draggable="false" />

    <div class="absolute bottom-6 left-1/2 flex -translate-x-1/2 gap-2">
      {showcases.map((_, i) => (
        <button
          class="assistant-lightbox-dot h-2 w-2 rounded-full bg-background/30 transition-all duration-300"
          data-index={i}
          aria-label={`Go to example ${i + 1}`}
        />
      ))}
    </div>
  </div>
</section>

<script define:vars={{ showcases }}>
  let index = 0;
  const track = document.getElementById('assistant-track');
  const caption = document.getElementById('assistant-caption');
  const sub = document.getElementById('assistant-sub');
  const dots = document.querySelectorAll('.assistant-dot');

  function render() {
    track.style.transform = `translateX(-${index * 100}%)`;
    caption.textContent = showcases[index].caption;
    sub.textContent = showcases[index].sub;
    dots.forEach((d, i) => {
      d.classList.toggle('bg-accent', i === index);
      d.classList.toggle('w-6', i === index);
      d.classList.toggle('bg-background/30', i !== index);
    });
  }

  document.getElementById('assistant-prev')?.addEventListener('click', () => {
    index = (index - 1 + showcases.length) % showcases.length;
    render();
  });
  document.getElementById('assistant-next')?.addEventListener('click', () => {
    index = (index + 1) % showcases.length;
    render();
  });
  dots.forEach((d) => {
    d.addEventListener('click', () => {
      index = Number(d.dataset.index);
      render();
    });
  });

  let startX = 0;
  track?.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; }, { passive: true });
  track?.addEventListener('touchend', (e) => {
    const diff = e.changedTouches[0].clientX - startX;
    if (diff > 40) { index = (index - 1 + showcases.length) % showcases.length; render(); }
    else if (diff < -40) { index = (index + 1) % showcases.length; render(); }
  }, { passive: true });

  render();

  const lightbox = document.getElementById('assistant-lightbox');
  const lightboxImg = document.getElementById('assistant-lightbox-img');
  const closeBtn = document.getElementById('assistant-lightbox-close');
  const lightboxDots = document.querySelectorAll('.assistant-lightbox-dot');

  function updateLightbox() {
    const current = showcases[index];
    lightboxImg.src = `/images/assistant/${current.img}`;
    lightboxImg.alt = current.caption;
    lightboxDots.forEach((d, i) => {
      d.classList.toggle('bg-background', i === index);
      d.classList.toggle('w-6', i === index);
      d.classList.toggle('bg-background/30', i !== index);
    });
  }

  function openLightbox() {
    updateLightbox();
    lightbox.classList.remove('hidden');
    lightbox.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lightbox.classList.add('hidden');
    lightbox.classList.remove('flex');
    document.body.style.overflow = '';
  }

  function lightboxPrev() {
    index = (index - 1 + showcases.length) % showcases.length;
    render();
    updateLightbox();
  }

  function lightboxNext() {
    index = (index + 1) % showcases.length;
    render();
    updateLightbox();
  }

  document.querySelectorAll('.assistant-zoom').forEach((btn) => {
    btn.addEventListener('click', () => {
      index = Number(btn.dataset.index);
      render();
      openLightbox();
    });
  });

  document.getElementById('assistant-zoom-hint')?.addEventListener('click', openLightbox);

  document.getElementById('assistant-lightbox-prev')?.addEventListener('click', lightboxPrev);
  document.getElementById('assistant-lightbox-next')?.addEventListener('click', lightboxNext);
  lightboxDots.forEach((d) => {
    d.addEventListener('click', () => {
      index = Number(d.dataset.index);
      render();
      updateLightbox();
    });
  });

  closeBtn?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (lightbox.classList.contains('hidden')) return;
    if (e.key === 'Escape') closeLightbox();
    if (e.key === 'ArrowLeft') lightboxPrev();
    if (e.key === 'ArrowRight') lightboxNext();
  });

  let lightboxStartX = 0;
  lightboxImg?.addEventListener('touchstart', (e) => { lightboxStartX = e.touches[0].clientX; }, { passive: true });
  lightboxImg?.addEventListener('touchend', (e) => {
    const diff = e.changedTouches[0].clientX - lightboxStartX;
    if (diff > 40) lightboxPrev();
    else if (diff < -40) lightboxNext();
  }, { passive: true });
</script>
