---
import Icon from './Icon.astro';

const features = [
  { icon: 'plug-zap', title: 'Control anything', text: '"Turn off the outlets in the kids\u2019 room" — done, wherever you are.' },
  { icon: 'shield-check', title: 'Security check-ups', text: '"Is everything locked?" — a full status report in seconds.' },
  { icon: 'list-checks', title: 'Give it tasks', text: '"Warm the house to 22\u00b0 by 6 pm Friday" — it remembers and does it.' },
  { icon: 'plane', title: 'Works from anywhere', text: 'Airport, office, another continent — your home is one message away.' },
];

const chat = [
  { from: 'user', text: 'Hey, we just left for the airport — did I turn the iron off?', time: '14:02' },
  { from: 'bot', text: 'Checked: the iron outlet is off. I also noticed the garage door is still open — closing it now.', time: '14:02' },
  { from: 'user', text: 'Great. Switch the house to away mode and keep an eye on things', time: '14:03' },
  { from: 'bot', text: 'Done. Away mode on: heating lowered to 17\u00b0, lights will simulate presence at dusk, all sensors armed. I\u2019ll ping you if anything moves.', time: '14:03' },
  { from: 'user', text: 'And warm it up before we\u2019re back on Sunday, around 6 pm', time: '14:04' },
  { from: 'bot', text: 'Scheduled. Sunday 6:00 pm — the house will be 22\u00b0 and the entry lights on. Have a good flight!', time: '14:04' },
];
---

<section id="assistant" class="py-20 md:py-28">
  <div class="mx-auto grid max-w-7xl items-center gap-12 px-5 md:px-8 lg:grid-cols-2 lg:gap-16">
    <div class="reveal">
      <p class="flex items-center gap-2 text-sm font-bold uppercase tracking-[0.25em] text-accent">
        <Icon name="bot-message-square" class="h-4 w-4" /> Optional add-on
      </p>
      <h2 class="h-display mt-4 text-4xl md:text-6xl">
        Text your home.
        <br />
        <span class="font-script font-semibold tracking-normal text-accent">It texts back.</span>
      </h2>
      <p class="mt-6 max-w-md text-base leading-relaxed text-muted-foreground md:text-lg">
        The AI Home Assistant is your personal home manager inside Telegram.
        No new app to learn — just chat. Ask it to switch off outlets, run a
        security check, set the heating — from the office, the airport or a
        beach halfway around the world.
      </p>

      <ul class="mt-8 space-y-5">
        {features.map((f) => (
          <li class="flex items-start gap-4">
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl bg-foreground text-background">
              <Icon name={f.icon} class="h-5 w-5" strokeWidth={1.7} />
            </span>
            <div>
              <div class="text-sm font-black uppercase tracking-wider">{f.title}</div>
              <div class="mt-1 text-sm leading-relaxed text-muted-foreground">{f.text}</div>
            </div>
          </li>
        ))}
      </ul>

      <p class="mt-8 max-w-md rounded-2xl border border-border bg-secondary/50 p-4 text-xs font-semibold leading-relaxed text-muted-foreground">
        Runs locally on your home controller — conversations and commands stay
        private, and core automations keep working even if the internet drops.
      </p>

      <a href="#quote" class="btn-dark mt-8 inline-flex px-6 py-3 text-sm">Add it to my quote</a>
    </div>

    <div class="reveal">
      <div class="overflow-hidden rounded-3xl border border-border bg-card shadow-2xl shadow-foreground/15">
        <div class="flex items-center gap-3 border-b border-border bg-secondary/60 px-5 py-4">
          <span class="relative flex h-11 w-11 items-center justify-center rounded-full bg-foreground text-background">
            <Icon name="bot-message-square" class="h-5 w-5" />
            <span class="absolute -bottom-0.5 -right-0.5 h-3.5 w-3.5 rounded-full border-2 border-card bg-emerald-500"></span>
          </span>
          <div>
            <div class="text-sm font-black tracking-tight">Home Manager</div>
            <div class="text-xs font-semibold text-muted-foreground">online · via Telegram</div>
          </div>
          <Icon name="lock" class="ml-auto h-4 w-4 text-muted-foreground" />
        </div>

        <div class="space-y-3 bg-secondary/30 px-4 py-5 md:px-5">
          {chat.map((m) => (
            <div class={`flex ${m.from === 'user' ? 'justify-end' : 'justify-start'}`}>
              <div class={`max-w-[85%] rounded-2xl px-4 py-2.5 text-sm leading-relaxed shadow-sm ${
                m.from === 'user' ? 'rounded-br-md bg-foreground text-background' : 'rounded-bl-md border border-border bg-card'
              }`}>
                <p>{m.text}</p>
                <div class={`mt-1 flex items-center justify-end gap-1 text-[10px] font-semibold ${m.from === 'user' ? 'text-background/50' : 'text-muted-foreground'}`}>
                  {m.time}
                  {m.from === 'user' ? (
                    <Icon name="check-check" class="h-3 w-3 text-accent" />
                  ) : (
                    <Icon name="check" class="h-3 w-3" />
                  )}
                </div>
              </div>
            </div>
          ))}

          <div class="flex items-center gap-2 pt-2">
            <div class="flex-1 rounded-full border border-border bg-card px-4 py-2.5 text-sm text-muted-foreground">
              Message your home…
            </div>
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-accent text-accent-foreground">
              <Icon name="send" class="h-4 w-4" />
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
