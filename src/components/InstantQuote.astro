---
import Icon from './Icon.astro';
---

<section id="quote" class="py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="text-sm font-bold uppercase tracking-[0.25em] text-accent">Get in touch</p>
      <h2 class="h-display mt-4 text-4xl md:text-6xl">
        Tell us about
        <br />
        <span class="font-script font-semibold tracking-normal text-accent">your home.</span>
      </h2>
      <p class="mt-6 text-base leading-relaxed text-muted-foreground md:text-lg">
        A few details and we'll get back to you within one business day with next steps and pricing.
      </p>
    </div>

    <div class="reveal mx-auto mt-14 max-w-xl rounded-3xl border border-border bg-card p-6 shadow-2xl shadow-foreground/10 md:p-10">
      <form id="quote-form" action="https://formspree.io/f/xjyboglq" method="POST" class="flex flex-col gap-4">
        <div>
          <label for="name" class="mb-1.5 block text-xs font-black uppercase tracking-widest text-muted-foreground">Name</label>
          <input required type="text" name="name" id="name" placeholder="Your name" class="w-full rounded-2xl border border-border bg-background px-4 py-3 text-sm outline-none transition-colors placeholder:text-muted-foreground/60 focus:border-accent" />
        </div>

        <div>
          <label for="email" class="mb-1.5 block text-xs font-black uppercase tracking-widest text-muted-foreground">Email</label>
          <input required type="email" name="email" id="email" placeholder="you@example.com" class="w-full rounded-2xl border border-border bg-background px-4 py-3 text-sm outline-none transition-colors placeholder:text-muted-foreground/60 focus:border-accent" />
        </div>

        <div>
          <label for="phone" class="mb-1.5 block text-xs font-black uppercase tracking-widest text-muted-foreground">Phone (optional)</label>
          <input type="tel" name="phone" id="phone" placeholder="(xxx) xxx-xxxx" class="w-full rounded-2xl border border-border bg-background px-4 py-3 text-sm outline-none transition-colors placeholder:text-muted-foreground/60 focus:border-accent" />
        </div>

        <div>
          <label for="message" class="mb-1.5 block text-xs font-black uppercase tracking-widest text-muted-foreground">Message</label>
          <textarea name="message" id="message" rows="4" placeholder="Tell us about your home and what you're looking for..." class="w-full resize-none rounded-2xl border border-border bg-background px-4 py-3 text-sm outline-none transition-colors placeholder:text-muted-foreground/60 focus:border-accent"></textarea>
        </div>

        <input type="hidden" name="_subject" value="New message — My Birdhouse website" />

        <button type="submit" id="quote-submit" class="btn-dark mt-2 px-6 py-3.5 text-sm">
          <Icon name="mail" class="h-4 w-4" />
          Send message
        </button>
      </form>

      <p id="quote-toast" class="mt-4 hidden rounded-xl p-3 text-center text-sm font-semibold"></p>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('quote-form') as HTMLFormElement | null;
  const submitBtn = document.getElementById('quote-submit') as HTMLButtonElement | null;
  const toast = document.getElementById('quote-toast');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!submitBtn || !toast) return;

    submitBtn.disabled = true;
    submitBtn.classList.add('opacity-60');

    try {
      const res = await fetch(form.action, {
        method: 'POST',
        body: new FormData(form),
        headers: { Accept: 'application/json' },
      });

      if (res.ok) {
        toast.textContent = "Thanks! We've received your message and will get back to you within one business day.";
        toast.classList.remove('hidden', 'bg-red-500/10', 'text-red-600');
        toast.classList.add('bg-accent/10', 'text-accent');
        form.reset();
      } else {
        throw new Error('Submission failed');
      }
    } catch {
      toast.textContent = 'Something went wrong sending your message — please email info@mybirdhouse.ca directly.';
      toast.classList.remove('hidden', 'bg-accent/10', 'text-accent');
      toast.classList.add('bg-red-500/10', 'text-red-600');
    } finally {
      submitBtn.disabled = false;
      submitBtn.classList.remove('opacity-60');
    }
  });
</script>
