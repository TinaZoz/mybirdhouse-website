---
const badges = [
  { abbr: 'BC', label: 'Registered BC Business', sub: 'Sole Proprietorship' },
  { abbr: 'LIC', label: 'Licensed Subcontractors', sub: 'For all electrical & plumbing work' },
  { abbr: 'CSA', label: 'Certified Equipment Only', sub: 'CSA / UL listed hardware' },
  { abbr: '1:1', label: 'Founder-Led Installs', sub: 'You work directly with the owner' },
  { abbr: 'NEW', label: 'Founding Client Pricing', sub: 'Now booking in the Fraser Valley' },
];

const stats = [
  { value: 'Aug 2026', label: 'Founded, right here in Maple Ridge' },
  { value: '3–6 mo', label: 'Included workmanship warranty' },
  { value: '100%', label: 'Hardware sold at cost, no markup games' },
  { value: '1', label: 'Direct line to the person doing your install' },
];
---

<section id="proof" class="py-20 md:py-28">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="text-sm font-bold uppercase tracking-[0.25em] text-accent">Credentials &amp; proof</p>
      <h2 class="h-display mt-4 text-4xl md:text-6xl">
        Brand new,
        <br />
        <span class="font-script font-semibold tracking-normal text-accent">fully transparent.</span>
      </h2>
      <p class="mt-4 text-sm leading-relaxed text-muted-foreground md:text-base">
        My Birdhouse just opened its doors in Maple Ridge, BC. No inflated
        reviews, no borrowed credentials — just an honest starting point and
        pricing you can check against the invoice.
      </p>
    </div>

    <div class="reveal mt-12 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
      {badges.map((b) => (
        <div class="flex flex-col items-center rounded-2xl border border-border bg-card px-4 py-6 text-center transition-all hover:-translate-y-1 hover:shadow-lg">
          <span class="flex h-14 w-14 items-center justify-center rounded-full bg-foreground text-lg font-black tracking-tight text-background">
            {b.abbr}
          </span>
          <div class="mt-3 text-xs font-black uppercase tracking-wider">{b.label}</div>
          <div class="mt-1 text-xs font-medium text-muted-foreground">{b.sub}</div>
        </div>
      ))}
    </div>

    <div class="reveal mt-12 grid grid-cols-2 gap-8 rounded-3xl bg-secondary/70 px-8 py-10 lg:grid-cols-4">
      {stats.map((s) => (
        <div class="text-center">
          <div class="text-4xl font-black tracking-tight text-foreground md:text-5xl">{s.value}</div>
          <div class="mt-2 text-sm font-semibold text-muted-foreground">{s.label}</div>
        </div>
      ))}
    </div>

    <div class="reveal mt-12 rounded-3xl border border-dashed border-accent/40 bg-accent/[0.06] p-8 text-center md:p-12">
      <p class="text-xs font-bold uppercase tracking-[0.25em] text-accent">Founding clients</p>
      <h3 class="h-display mt-3 text-2xl md:text-4xl">
        Be one of our first homes.
      </h3>
      <p class="mx-auto mt-4 max-w-xl text-sm leading-relaxed text-muted-foreground md:text-base">
        As an early client you get the owner on-site for your install, direct
        access for questions afterward, and pricing locked in before rates
        change as we grow. Your feedback genuinely shapes what we build next.
      </p>
      <a href="#quote" class="btn-dark mt-6 inline-flex px-6 py-3 text-sm">Get my price in 2 minutes</a>
    </div>
  </div>
</section>
