---
import Icon from './Icon.astro';

const showcases = [
  {
    id: 'energy',
    icon: 'zap',
    kicker: 'Energy showcase',
    title: 'Your home,',
    script: 'wasting nothing.',
    text: 'Watch every circuit in real time. EV charging, heat pump and baseboards — optimized automatically to shave the peaks off your BC Hydro bill.',
    image: '/images/showcase-energy.png',
    alt: 'Modern BC home with an EV charging by the garage at golden hour',
    reverse: false,
  },
  {
    id: 'comfort',
    icon: 'sun',
    kicker: 'Comfort showcase',
    title: 'Perfect temperature,',
    script: 'room by room.',
    text: 'Occupancy-based heating and cooling that follows your life, not a schedule. Voice, app or fully automatic — the house just knows when you\u2019re home.',
    image: '/images/about-interior.png',
    alt: 'Cozy smart living room with a wall-mounted home control panel at dusk',
    reverse: true,
  },
  {
    id: 'safety',
    icon: 'shield-check',
    kicker: 'Safety showcase',
    title: 'Protected,',
    script: 'even at 3 a.m.',
    text: 'Leak sensors close the water before damage spreads. Gas and CO2 stay on battery backup even in an outage. Doors lock themselves when the house goes to sleep.',
    image: '/images/showcase-safety.png',
    alt: 'Warm-lit wooden home entrance with smart lock and garden path lights at night',
    reverse: false,
  },
];
---

<section id="showcases">
  {showcases.map((s) => (
    <div class={`relative overflow-hidden py-16 md:py-24 ${s.reverse ? 'bg-secondary/60' : ''}`}>
      <div class="mx-auto grid max-w-7xl items-center gap-10 px-5 md:px-8 lg:grid-cols-2 lg:gap-16">
        <div class={`reveal ${s.reverse ? 'lg:order-2' : ''}`}>
          <p class="flex items-center gap-2 text-sm font-bold uppercase tracking-[0.25em] text-accent">
            <Icon name={s.icon} class="h-4 w-4" /> {s.kicker}
          </p>
          <h3 class="h-display mt-4 text-4xl md:text-6xl">
            {s.title}
            <br />
            <span class="font-script font-semibold tracking-normal text-accent">{s.script}</span>
          </h3>
          <p class="mt-6 max-w-md text-base leading-relaxed text-muted-foreground md:text-lg">{s.text}</p>
          <a href="#quote" class="btn-dark mt-8 inline-flex px-6 py-3 text-sm">Get a quote for my home</a>
        </div>

        <div class={`reveal relative ${s.reverse ? 'lg:order-1' : ''}`}>
          <div class="overflow-hidden rounded-3xl shadow-2xl shadow-foreground/20">
            <img src={s.image} alt={s.alt} class="h-full w-full object-cover transition-transform duration-700 hover:scale-[1.03]" />
          </div>

          {s.id === 'energy' && (
            <div class="absolute -bottom-8 left-5 right-5 sm:left-8 sm:right-auto sm:w-80 md:-bottom-10">
              <div class="rounded-2xl bg-background/95 p-5 shadow-2xl backdrop-blur">
                <div class="flex items-center justify-between">
                  <span class="text-sm font-bold">Today</span>
                  <span class="flex items-center gap-1 rounded-full bg-accent/10 px-2.5 py-1 text-xs font-bold text-accent">
                    <Icon name="trending-down" class="h-3.5 w-3.5" /> −31%
                  </span>
                </div>
                <div class="mt-1 text-3xl font-black tracking-tight">
                  9.4 <span class="text-base font-bold text-muted-foreground">kWh</span>
                </div>
                <div class="mt-4 flex h-16 items-end gap-1.5">
                  {[40, 55, 45, 70, 90, 60, 35, 50, 42, 30, 26, 22].map((h, i) => (
                    <div class={`flex-1 rounded-t-md ${i >= 6 ? 'bg-accent' : 'bg-foreground/20'}`} style={`height:${h}%`}></div>
                  ))}
                </div>
                <div class="mt-2 flex justify-between text-[10px] font-semibold uppercase tracking-wider text-muted-foreground">
                  <span>6 am</span><span>evening peak</span><span>11 pm</span>
                </div>
              </div>
            </div>
          )}

          {s.id === 'comfort' && (
            <div class="absolute -bottom-8 left-5 right-5 sm:left-8 sm:right-auto sm:w-80 md:-bottom-10">
              <div class="rounded-2xl bg-foreground p-5 text-background shadow-2xl">
                <div class="text-sm font-bold text-background/80">Bedroom</div>
                <div class="mt-1 flex items-end justify-between">
                  <span class="text-5xl font-black tracking-tight">21°</span>
                  <span class="mb-1 rounded-full bg-accent px-3 py-1 text-xs font-bold text-accent-foreground">Eco · away in 20 min</span>
                </div>
                <div class="mt-4 space-y-2">
                  {[['Living room', '22°', 'w-2/3'], ['Kitchen', '21°', 'w-1/2'], ['Basement', '19°', 'w-1/3']].map(([room, temp, w]) => (
                    <div class="flex items-center gap-3">
                      <span class="w-20 text-xs font-semibold text-background/60">{room}</span>
                      <div class="h-1.5 flex-1 rounded-full bg-background/15">
                        <div class={`h-full rounded-full bg-accent ${w}`}></div>
                      </div>
                      <span class="text-xs font-bold">{temp}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>
          )}

          {s.id === 'safety' && (
            <div class="absolute -bottom-8 left-5 right-5 sm:left-8 sm:right-auto sm:w-80 md:-bottom-10">
              <div class="space-y-3">
                <div class="flex items-center gap-3 rounded-2xl bg-background/95 p-4 shadow-2xl backdrop-blur">
                  <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent text-accent-foreground">
                    <Icon name="triangle-alert" class="h-5 w-5" />
                  </span>
                  <div class="min-w-0">
                    <div class="text-sm font-black">Leak detected — water shut off</div>
                    <div class="truncate text-xs font-semibold text-muted-foreground">Basement · main valve closed automatically</div>
                  </div>
                </div>
                <div class="flex items-center gap-3 rounded-2xl bg-background/95 p-4 shadow-2xl backdrop-blur">
                  <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-foreground text-background">
                    <Icon name="lock" class="h-5 w-5" />
                  </span>
                  <div class="min-w-0">
                    <div class="text-sm font-black">All doors locked</div>
                    <div class="truncate text-xs font-semibold text-muted-foreground">Good-night scene · 11:04 pm</div>
                  </div>
                </div>
              </div>
            </div>
          )}
        </div>
      </div>
      <div class="h-14 md:h-16"></div>
    </div>
  ))}
</section>
