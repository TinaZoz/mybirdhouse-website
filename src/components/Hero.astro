---
---

<section id="top" class="relative min-h-[640px] overflow-visible sm:min-h-0">
  <img
    src="/images/hero-banner.jpg"
    alt="Smart living. Naturally. — AI automated smart home by My Birdhouse on a British Columbia lakeshore"
    class="absolute inset-0 h-full w-full select-none object-cover sm:static sm:h-auto sm:w-full sm:object-none"
    draggable="false"
  />

  <div class="absolute left-[4%] top-[11%] max-w-[80%] text-left sm:left-[5%] sm:top-[15%] sm:max-w-[38%]">
    <div class="inline-block rounded-2xl bg-background/60 p-3 shadow-xl shadow-foreground/10 backdrop-blur-md sm:rounded-3xl sm:p-6">
      <p class="h-display whitespace-nowrap text-[clamp(1.6rem,4.6vw,4.75rem)] text-foreground">
        Smart Living.
      </p>
      <p class="font-script text-[clamp(1.3rem,3.4vw,3.25rem)] leading-tight text-accent">
        Naturally
      </p>
      <p class="mt-2 text-[11px] leading-snug text-foreground/75 sm:mt-4 sm:text-base sm:leading-relaxed">
        AI-automated homes across British Columbia — energy, comfort and
        safety that quietly run themselves. Transparent one-time pricing,
        hardware at cost.
      </p>
      <div class="mt-3 flex flex-col gap-2.5 sm:mt-6 sm:flex-row sm:items-center sm:gap-3">
        <a href="#quote" class="btn-dark px-5 py-2.5 text-xs sm:px-7 sm:py-3.5 sm:text-sm">
          Get my price
          <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5 sm:h-4 sm:w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a
          href="#showcases"
          class="btn-pill border-2 border-foreground/15 bg-white/70 px-5 py-2.5 text-xs text-foreground backdrop-blur-md hover:bg-foreground hover:text-white sm:px-7 sm:py-3.5 sm:text-sm"
        >
          See it in action
        </a>
      </div>
    </div>
  </div>

  <div class="pointer-events-none absolute inset-x-0 bottom-0 h-24 bg-gradient-to-t from-background/80 to-transparent"></div>

  <a
    href="#overview"
    aria-label="Scroll down"
    class="absolute bottom-[3.5%] left-1/2 hidden -translate-x-1/2 text-foreground/50 transition-colors hover:text-foreground md:block"
  >
    <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 animate-bounce" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
  </a>
</section>
