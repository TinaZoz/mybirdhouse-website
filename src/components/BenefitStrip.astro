---
import Icon from './Icon.astro';

const benefits = [
  { icon: 'leaf', title: 'Save Energy', text: 'Lower bills, smaller footprint.' },
  { icon: 'droplets', title: 'Prevent Leaks', text: 'Detect issues early, protect your home.' },
  { icon: 'shield-check', title: 'Feel Secure', text: '24/7 monitoring for peace of mind.' },
  { icon: 'house', title: 'Live Comfortably', text: 'The perfect home environment, always.' },
  { icon: 'smartphone', title: 'All in One', text: 'Everything works together, simply.' },
];
---

<section class="reveal border-b border-border">
  <div class="mx-auto grid max-w-7xl grid-cols-2 items-start gap-x-6 gap-y-8 px-5 py-10 md:grid-cols-3 md:px-8 lg:grid-cols-5">
    {benefits.map((b, i) => (
      <div class={`flex items-start gap-4 ${i > 0 ? 'lg:border-l lg:border-border lg:pl-8' : ''} ${i === 4 ? 'hidden md:flex' : ''}`}>
        <span class="mt-0.5 flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-foreground/15 text-foreground/75">
          <Icon name={b.icon} class="h-5 w-5" strokeWidth={1.5} />
        </span>
        <div>
          <div class="text-xs font-black uppercase tracking-widest text-foreground">{b.title}</div>
          <div class="mt-1.5 text-sm leading-snug text-muted-foreground">{b.text}</div>
        </div>
      </div>
    ))}
  </div>
</section>
